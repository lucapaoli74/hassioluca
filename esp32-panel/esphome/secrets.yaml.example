# Copia in secrets.yaml (ignorato da git) e metti i valori veri.
wifi_ssid: "NomeDellaTuaWifi"
wifi_password: "PasswordWifi"
# rete di emergenza creata dal pannello quando non trova la WiFi
ap_password: "AlmenoOttoCaratteri"
ota_password: "UnaPasswordRobusta"
# accesso all'interfaccia web http://pannello-esp32.local (utente: admin)
web_password: "UnaPasswordRobusta"

# Solo se attivi integrations/homeassistant.yaml — genera con:
#   python3 -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
api_encryption_key: "CHIAVE_BASE64_DA_32_BYTE"

# Solo se attivi integrations/mqtt.yaml
mqtt_broker: "192.168.1.10"
mqtt_username: "pannello"
mqtt_password: "PasswordMqtt"

# Telecamere di rete per la pagina Telecamere: "Nome|URL dello snapshot".
# Generale con:  python3 ../tools/trova-telecamere.py --utente admin --password ...
telecamere: |-
  {
    "Reolink ingresso|http://192.168.1.50/cgi-bin/api.cgi?cmd=Snap&channel=0&rs=pannello&width=640&height=360&user=admin&password=PASSWORD",
    "EZVIZ giardino|http://192.168.1.60:1984/api/frame.jpeg?src=ezviz_giardino",
  }
