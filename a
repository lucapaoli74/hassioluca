#!/bin/bash
# Installatore di Asclepio (copia di lucapaoli74/Asclepio deploy/installa.sh), pubblicato qui
# per poterlo scaricare con un comando breve. Non contiene password né dati.
set -euo pipefail
DOMAIN=asclepio.net
REPO=git@github.com:lucapaoli74/Asclepio.git
BRANCH=claude/charming-faraday-pn7xr4
APP=/opt/asclepio
export DEBIAN_FRONTEND=noninteractive

echo ">>> 1/6 Aggiornamento del sistema e programmi di base"
apt-get update -qq
apt-get -y -qq upgrade
apt-get -y -qq install ca-certificates curl git ufw fail2ban unattended-upgrades restic openssl
dpkg-reconfigure -f noninteractive unattended-upgrades

echo ">>> 2/6 Firewall: solo SSH, HTTP e HTTPS"
ufw default deny incoming >/dev/null
ufw default allow outgoing >/dev/null
ufw allow OpenSSH >/dev/null
ufw allow 80/tcp >/dev/null
ufw allow 443/tcp >/dev/null
ufw --force enable >/dev/null
systemctl enable --now fail2ban >/dev/null

echo ">>> 3/6 Docker"
if ! command -v docker >/dev/null; then
    install -m 0755 -d /etc/apt/keyrings
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" > /etc/apt/sources.list.d/docker.list
    apt-get update -qq
    apt-get -y -qq install docker-ce docker-ce-cli containerd.io docker-compose-plugin
fi

echo ">>> 4/6 Chiave di accesso a GitHub (sola lettura)"
mkdir -p /root/.ssh && chmod 700 /root/.ssh
[ -f /root/.ssh/asclepio_github ] || ssh-keygen -q -t ed25519 -N "" -C "server asclepio.net" -f /root/.ssh/asclepio_github
ssh-keyscan -t ed25519 github.com >> /root/.ssh/known_hosts 2>/dev/null
cat > /root/.ssh/config <<CONF
Host github.com
    IdentityFile /root/.ssh/asclepio_github
    IdentitiesOnly yes
CONF
if ! git ls-remote "$REPO" >/dev/null 2>&1; then
    echo
    echo "=================================================================="
    echo " COPIA LA RIGA QUI SOTTO (inizia con ssh-ed25519) E INCOLLALA SU:"
    echo " https://github.com/lucapaoli74/Asclepio/settings/keys/new"
    echo " Title: server, NON spuntare 'Allow write access', poi 'Add key'."
    echo "=================================================================="
    echo
    cat /root/.ssh/asclepio_github.pub
    echo
    echo "In attesa che la chiave venga aggiunta su GitHub..."
    until git ls-remote "$REPO" >/dev/null 2>&1; do sleep 10; done
    echo "Chiave accettata da GitHub."
fi

echo ">>> 5/6 Scaricamento di Asclepio e configurazione"
[ -d "$APP/.git" ] || git clone -q --branch "$BRANCH" "$REPO" "$APP"
echo "$BRANCH" > /etc/asclepio-branch
cd "$APP"
if [ ! -f deploy/.env ]; then
    rnd() { openssl rand -base64 36 | tr -d '/+=' | cut -c1-40; }
    sed -e "s/^DJANGO_SECRET_KEY=.*/DJANGO_SECRET_KEY=$(rnd)/" \
        -e "s/^POSTGRES_SUPERUSER_PASSWORD=.*/POSTGRES_SUPERUSER_PASSWORD=$(rnd)/" \
        -e "s/^POSTGRES_PASSWORD=.*/POSTGRES_PASSWORD=$(rnd)/" \
        -e "s/^RESTIC_PASSWORD=.*/RESTIC_PASSWORD=$(rnd)/" \
        deploy/.env.example > deploy/.env
    chmod 600 deploy/.env
fi

echo ">>> 6/6 Avvio (qualche minuto la prima volta)"
docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env up -d --build

cat > /etc/systemd/system/asclepio-aggiorna.service <<UNIT
[Unit]
Description=Aggiornamento automatico di Asclepio
[Service]
Type=oneshot
ExecStart=$APP/deploy/aggiorna.sh
UNIT
cat > /etc/systemd/system/asclepio-aggiorna.timer <<UNIT
[Unit]
Description=Controlla aggiornamenti di Asclepio ogni 5 minuti
[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
[Install]
WantedBy=timers.target
UNIT
systemctl daemon-reload
systemctl enable --now asclepio-aggiorna.timer >/dev/null

if [ ! -f /root/asclepio-admin.txt ]; then
    PASS=$(openssl rand -base64 18 | tr -d '/+=')
    for i in $(seq 1 30); do
        docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env exec -T \
            -e DJANGO_SUPERUSER_PASSWORD="$PASS" web \
            python manage.py createsuperuser --noinput --username admin --email admin@$DOMAIN >/dev/null 2>&1 && break
        sleep 10
    done
    printf "utente: admin\npassword: %s\n" "$PASS" > /root/asclepio-admin.txt
    chmod 600 /root/asclepio-admin.txt
fi

echo
echo "=================================================================="
echo " FATTO. Asclepio: https://$DOMAIN"
echo " Gestione:        https://$DOMAIN/gestione/"
cat /root/asclepio-admin.txt
echo " Annota la password in un posto sicuro (resta anche in /root/asclepio-admin.txt)."
echo " Da ora il server si aggiorna da solo."
echo "=================================================================="
